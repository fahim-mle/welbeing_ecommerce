# Docker Compose Environment Variables
# Copy this to .env and adjust for your deployment
# ALL variables are REQUIRED - no defaults in compose.yaml

# PostgreSQL Configuration
POSTGRES_USER=welbeing
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=welbeing_production

# Backend Configuration
DATABASE_URL=postgresql://welbeing:change-this-secure-password@postgres:5432/welbeing_production?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-domain.com

# Note: For production deployments, use Docker secrets or a secret manager
# instead of plain text environment variables
