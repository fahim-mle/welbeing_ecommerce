# Backend env
# Copy to .env and adjust as needed.

# Postgres (dev) — docker compose maps host 5433 -> container 5432 to avoid conflict with system Postgres.
# Replace USER, PASSWORD, HOST, PORT, and DB_NAME for your environment.
DATABASE_URL="postgresql://USER:PASSWORD/HOST:PORT/DB_NAME?schema=public"

# Optional: separate URL for tests (defaults to DATABASE_URL)
TEST_DATABASE_URL="postgresql://USER:PASSWORD/HOST:PORT/TEST_DB_NAME?schema=public"
TEST_DATABASE_SCHEMA="jest_test"

# Redis (optional; caching). App tolerates Redis being down.
# If you use the compose redis service, it is not published to the host by default.
REDIS_URL="redis://HOST:PORT"

PORT=3000
NODE_ENV=development
# Required in production; for local dev keep simple
JWT_SECRET="change-me"

# Allowed origin(s) for CORS. Comma-separated for multiple domains.
# Must match the frontend URL exactly. Never use * with credentials.
CORS_ORIGIN="http://localhost:5173"

# Image uploads. Local adapter stores optimized WebP files under UPLOAD_DIR and serves them at UPLOAD_BASE_URL.
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"
UPLOAD_BASE_URL="/uploads"

# Email. If RESEND_API_KEY is absent, email calls log safely for local development.
RESEND_API_KEY=""
EMAIL_FROM="Welbeing Store <noreply@example.invalid>"
APP_URL="http://localhost:5173"
