# Backend env
# Copy to .env and adjust as needed.

# Postgres (dev) — note: docker compose maps host 5433 -> container 5432 to avoid conflict with system Postgres.
DATABASE_URL="postgresql://welbeing:welbeing@localhost:5433/test_welbeing?schema=public"

# Redis (optional; caching). App tolerates Redis being down.
# If you use the compose redis service, it is not published to the host by default.
REDIS_URL="redis://localhost:6379"

PORT=3000
NODE_ENV=development
JWT_SECRET="change-me" # required in production; for local dev keep simple
